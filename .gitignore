# --- build output ---
build/
*.z64
*.v64
output/*
!output/README.md

# --- emulator / flashcart save files ---
*.eeprom
*.ram
*.sra
*.flash
*.fla
*.mpk

# --- copyrighted game data: never commit ---
# Bring your own Duke Nukem 3D files; see gamedata/README.md.
gamedata/*
!gamedata/README.md

# --- prebuilt game / host tools: built by `make engine` and
# tools/vendor/bin/build-tools.sh, or taken from a GitHub Release ---
tools/vendor/bin/*
!tools/vendor/bin/*.sh
!tools/vendor/bin/README.md
tools/vendor/engine/*
!tools/vendor/engine/README.md

# --- python cache ---
__pycache__/
*.pyc

# --- libdragon CLI local cache (keep the project marker) ---
.libdragon/*
!.libdragon/config.json

# --- CI staging ---
stage/
hosttools/
