diff --git a/src/audio/mixer.c b/src/audio/mixer.c
index 7fc80db9b..4de45b1db 100644
--- a/src/audio/mixer.c
+++ b/src/audio/mixer.c
@@ -588,11 +588,20 @@ static void mixer_ch_apply_freq(int ch, float frequency)
 {
 	mixer_channel_t *c = &Mixer.channels[ch];
 	assertf(frequency >= 0, "cannot set negative frequency on channel %d: %f", ch, frequency);
-	// Check if the frequency is within the configured limit. Allow for a 1%
-	// margin because of rounding errors for the default maximum frequency.
-	assertf(frequency <= Mixer.limits[ch].max_frequency * 1.01f,
-		"frequency %.1f exceeds configured limit %.1f on channel %d; use mixer_ch_set_limit to change the limit for this channel",
-		frequency, Mixer.limits[ch].max_frequency, ch);
+	// Keep the frequency within the configured limit, which sizes the channel's
+	// sample buffer. A synthesizer can go past it transiently (a high note plus
+	// a pitch envelope of the soundfont): play it at the limit instead of
+	// aborting, it is far past any audible pitch by then anyway. The 1% margin
+	// covers rounding errors for the default maximum frequency.
+	if (frequency > Mixer.limits[ch].max_frequency * 1.01f) {
+		static bool warned = false;
+		if (!warned) {
+			debugf("mixer: frequency %.1f exceeds configured limit %.1f on channel %d, clamped (use mixer_ch_set_limits to raise it)\n",
+				frequency, Mixer.limits[ch].max_frequency, ch);
+			warned = true;
+		}
+		frequency = Mixer.limits[ch].max_frequency;
+	}
 	mixer_fx64_t step = MIXER_FX64(frequency / (float)Mixer.sample_rate);
 	if (!(c->flags & CH_FLAGS_VADPCM))
 		step <<= (c->flags & CH_FLAGS_BPS_SHIFT);
